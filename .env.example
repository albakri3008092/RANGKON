# Kata laluan admin dashboard
RANGKON_ADMIN_PASSWORD=tukar-saya
RANGKON_SECRET_KEY=tukar-kepada-rentetan-rawak-panjang
# URL awam aplikasi (untuk pautan kehadiran dalam mesej WhatsApp)
RANGKON_PUBLIC_BASE_URL=http://localhost:8000
RANGKON_TIMEZONE=Asia/Kuala_Lumpur
RANGKON_UNITS="MK Rej,Bn 1,Bn 2,Bn 3"
# simulate = tiada mesej sebenar dihantar; cloud = WhatsApp Cloud API (Meta)
RANGKON_WHATSAPP_PROVIDER=simulate
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Kosongkan untuk hantar teks biasa (hanya sah dalam tetingkap 24 jam).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=ms
